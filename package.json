{
  "name": "zdsh-autopilot",
  "version": "0.1.0",
  "description": "zDSH AutoPilot — unified automation engine for DeepSeek Harness: interruption auto-resume, sandbox-first auto permission policy, and second-model approval review behind one kernel and one console.",
  "license": "MIT",
  "author": {
    "name": "zsagi1368"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zsagi1368/zdsh-autopilot.git"
  },
  "homepage": "https://github.com/zsagi1368/zdsh-autopilot#readme",
  "bugs": {
    "url": "https://github.com/zsagi1368/zdsh-autopilot/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "zdsh",
    "automation",
    "auto-continue",
    "approval",
    "permission",
    "plugin"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./dist/client.cjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist",
    "corpus",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "bin": {
    "zdsh-autopilot-eval": "./bin/autopilot-eval.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.2",
    "@deepseek-ai/dsh-client-connection": ">=0.1.0-rc.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.2",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.1.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": ">=0.1.0-rc.2",
    "@deepseek-ai/dsh-commands": ">=0.1.0-rc.2",
    "@deepseek-ai/dsh-invariants": ">=0.1.0-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.2",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.2",
    "@deepseek-ai/dsh-session-projection": ">=0.1.0-rc.2",
    "@deepseek-ai/dsh-subagent": ">=0.1.0-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.2",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-settings-plugins": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-invariants": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-subagent": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/cordis-plugin-include": "1.0.6",
    "@deepseek-ai/cordis-plugin-loader": "1.0.2",
    "@deepseek-ai/dsh-agent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-plugins": "0.1.1-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@deepseek-ai/dsh-session": "0.1.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.1.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.1.1-rc.2",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^26.0.0",
    "oxlint": "^1.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.14",
    "tsx": "^4.19.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.0",
    "yaml": "^2.8.2",
    "zod": "^4.4.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsdown",
    "build:client": "tsdown",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test": "vitest run",
    "lint": "node scripts/check-boundaries.mjs && oxlint src tests eval scripts bin",
    "eval": "node bin/autopilot-eval.mjs run eval/cases",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
